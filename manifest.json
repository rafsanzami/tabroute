{
  "manifest_version": 3,
  "name": "TabRoute — Per-Tab Proxy Switcher",
  "version": "1.0.0",
  "description": "Route a single tab, chosen domains, or incognito windows through Burp Suite or any HTTP proxy.",
  "homepage_url": "https://github.com/rafsanzami/tabroute",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "proxy",
    "storage",
    "tabs",
    "webRequest",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "incognito": "spanning",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabRoute",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    },
    "default_popup": "popup.html"
  },
  "commands": {
    "toggle-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Capture / release the current tab"
    }
  },
  "short_name": "TabRoute"
}
